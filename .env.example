BOT_TOKEN=123456:telegram-bot-token
ADMIN_USERNAME=natalia_trading

# Адрес готового Титан Трекера. Бот выдаёт его только активному VIP.
TITAN_TRACKER_URL=https://your-titan-tracker.example

# Секрет подписи персональной ссылки. Тот же ключ должен быть у Титан Трекера.
TITAN_ACCESS_SECRET=change-me
TITAN_ACCESS_TTL_HOURS=12

# 1 — вторая кнопка откроет трекер внутри Telegram.
# Домен ссылки нужно заранее указать в BotFather.
TITAN_WEBAPP=0
