# --- НАСТРОЙКИ (глобальные переменные) ---
load_dotenv()

# ВАЖНО: вставь сюда свой username без @ (например, natalia_trading)
ADMIN_USERNAME = "natalia_trading"

token = os.getenv("BOT_TOKEN")
