@dp.message(F.text == "💎 VIP: обучение и разбор сделок")
async def vip_info(message: Message):
    user_id = message.from_user.id
    user = message.from_user
    await upsert_user(user_id, user.username)

    # Проверка статуса VIP (убедитесь, что функция check_vip_status есть в db.py)
    try:
        status = await check_vip_status(user_id)
    except Exception as e:
        print(f"Ошибка проверки VIP статуса: {e}")
        status = {"is_vip": False, "is_expired": False}

    if status.get("is_vip"):
        await message.answer(
            "✅ VIP‑доступ активен! 🎉\n\n"
            "Ты в закрытом VIP‑потоке. Здесь мы разбираем сделки в моменте, смотрим ошибки и учимся торговать.\n"
            "Для торговли используй свою платформу (РТС/Pocket Option), а сюда скидывай скрин или тикер — я помогу разобрать.\n\n"
            "Что хочешь разобрать прямо сейчас? Напиши тикер (например, EURUSD) или прикрепи скрин сделки."
        )
    elif status.get("is_expired"):
        await message.answer(
            "⚠️ Твой VIP‑доступ истёк.\n\n"
            "Хочешь продлить обучение, чтобы снова разбирать сделки в моменте и учиться?\n"
            "Выбери действие ниже:",
            reply_markup=get_vip_action_keyboard()
        )
    else:
        await message.answer(
            "💎 VIP‑обучение и разбор сделок — это платная услуга.\n\n"
            "Что ты получишь:\n"
            "• Разбор твоих сделок в моменте — без «воды», только по делу.\n"
            "• Обучение и исправление ошибок — чтобы не повторять одни и те же ловушки.\n"
            "• Закрытый поток с персональной обратной связью — отвечаю именно тебе.\n"
            "• Живая торговля и разборы — в согласованное с тобой время (в рамках слотов).\n"
            "• Практические нюансы, о которых трейдеры часто не говорят: как держать дисциплину, как работать с просадкой, где прячутся скрытые комиссии и как устроены реальные рыночные механики (включая OTC и поведение ликвидности).\n\n"
            "Стоимость: плата раз в месяц.\n"
            "Автопродление: если ты продлеваешь, подписка продлевается автоматически на следующий месяц.\n\n"
            "Хочешь оформить доступ? Напиши «Хочу VIP» или нажми «Связаться с администратором», чтобы узнать точную стоимость и согласовать график."
        )

@dp.message(F.text == "✅ Продлить обучение (автопродление)")
async def vip_extend(message: Message):
    user_id = message.from_user.id
    try:
        await set_vip_subscription(user_id, days=30)
        await message.answer(
            "✅ Подписка продлена! Автопродление активировано.\n"
            "Теперь ты снова в VIP‑потоке: скидывай сделки — будем разбирать ошибки и учиться торговать."
        )
    except Exception as e:
        print(f"Ошибка продления подписки: {e}")
        await message.answer("Произошла ошибка при продлении подписки. Пожалуйста, свяжитесь с администратором.")

@dp.message(F.text == "❌ Не продлевать (отключить доступ)")
async def vip_cancel(message: Message):
    user_id = message.from_user.id
    try:
        await cancel_vip_subscription(user_id)
        await message.answer(
            "❌ Доступ к VIP‑обучению отключён.\n"
            "Ты остаёшься в клубе, но персональный разбор сделок и закрытые материалы больше недоступны.\n"
            "Если позже захочешь вернуться — нажми «💎 VIP: обучение и разбор сделок»."
        )
    except Exception as e:
        print(f"Ошибка отмены подписки: {e}")
        await message.answer("Произошла ошибка при отмене подписки. Пожалуйста, свяжитесь с администратором.")

