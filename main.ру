# --- ФУНКЦИИ КЛАВИАТУР ---

def get_main_keyboard():
    """Возвращает главное меню с кнопками"""
    builder = ReplyKeyboardBuilder()
    builder.button(text="📜 Правила клуба")
    builder.button(text="📅 Расписание сделок")
    builder.button(text="❓ Помощь")
    builder.button(text="📞 Связаться с администратором")
    builder.button(text="⚡ Кратко о правилах")
    builder.button(text="💎 VIP: обучение и разбор сделок")
    builder.adjust(2, 1, 1, 1, 1)
    return builder.as_markup(resize_keyboard=True)



def get_guide_keyboard():
    builder = ReplyKeyboardBuilder()
    builder.button(text="🔁 Ещё раз показать гайд")
    builder.adjust(1)
    return builder.as_markup(resize_keyboard=True)


def get_vip_action_keyboard():
    builder = ReplyKeyboardBuilder()
    builder.button(text="✅ Продлить обучение (автопродление)")
    builder.button(text="❌ Не продлевать (отключить доступ)")
    builder.adjust(1)
    return builder.as_markup(resize_keyboard=True)


# --- ХЕНДЛЕРЫ (ОБРАБОТЧИКИ СООБЩЕНИЙ) ---

@dp.message(Command("start"))
async def cmd_start(message: Message):
    user = message.from_user
    await upsert_user(user.id, user.username)
    
    welcome_text = """Привет! 👋
Добро пожаловать в Trading Club Bot!

Здесь ты сможешь:
- Проверять свой VIP-статус
- Управлять подпиской
- Получать торговые сигналы

Нажми /start, чтобы начать!"""
    
    await message.answer(welcome_text, reply_markup=get_main_keyboard())
async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())

