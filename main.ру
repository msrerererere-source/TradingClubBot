@dp.message(Command("start"))
async def cmd_start(message: Message):
    user = message.from_user
    await upsert_user(user.id, user.username)
    
    welcome_text = (
        "Привет! 👋 Добро пожаловать в Trading Club Bot!\n\n"
        "Выбери действие в меню ниже или напиши /guide, чтобы получить гайд по Entry Point."
    )
    await message.answer(welcome_text, reply_markup=get_vip_keyboard())

@dp.callback_query(F.data == "vip_signals")
async def handle_vip_signals(callback: CallbackQuery):
    user_id = callback.from_user.id
    
    # Проверяем подписку
    is_subscribed = await check_subscription(user_id)
    
    if is_subscribed:
        await callback.answer("✅ Доступ разрешён!", show_alert=False)
        await callback.message.answer("📈 Сигнал: BUY на паре BTC/USDT, Entry: 60000")
    else:
        await callback.answer("❌ У тебя нет подписки на VIP-сигналы", show_alert=True)


